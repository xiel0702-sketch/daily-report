        {
          "type": "paragraph",
          "text": "Opus 5.5 fast mode in the Claude Platform is no longer in research preview, and we’ve removed the waitlist!",
          "inlines": [
            {
              "text": "Opus 5.5 fast mode in the Claude Platform is no longer in research preview, and we’ve removed the waitlist!"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "It’s the same Opus 5.5 but up to 2.5x faster, at $8 / $40 per million tokens.",
          "inlines": [
            {
              "text": "It’s the same Opus 5.5 but up to 2.5x faster, at $8 / $40 per million tokens."
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "It's also available in Microsoft Foundry (Hosted on Azure), with Google Cloud coming soon.",
          "inlines": [
            {
              "text": "It's also available in Microsoft Foundry (Hosted on Azure), with Google Cloud coming soon."
